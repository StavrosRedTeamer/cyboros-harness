#!/usr/bin/env bash
# Cyboros Command Center — desktop launcher (WP2).
# Prefers the PyQt6 shell; falls back to Chromium app-mode, then the default browser.
# The backend stays owned by tools/gui-server.js (single instance via cc-instance).
set -euo pipefail

WS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$WS"

# Machine-local secrets for cloud chat/agent profiles (the api_key_env values named in
# runtime/providers.json) live outside the repo, same convention as ~/.config/manicode used
# elsewhere in this tree. A no-op on a fresh clone/machine with nothing there yet.
if [ -d "$HOME/.config/cyboros" ]; then
  shopt -s nullglob
  for f in "$HOME/.config/cyboros"/*.env; do source "$f"; done
  shopt -u nullglob
fi

if ! command -v node >/dev/null 2>&1; then
  echo "cyboros-cc: node >= 22 is required" >&2
  exit 1
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
  echo
  echo "options: --read-only --web --headless --kiosk --keep-server"
  exit 0
fi

exec python3 "$WS/tools/app/cyboros-cc.py" "$@"
