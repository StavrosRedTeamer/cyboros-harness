/* Stavros Console — offensive-security operations console.
   Zero external assets (CSP + offline safe). Identity: a forensic instrument
   panel where SEVERITY is the spine and PROOF LEVEL is encoded as shape.
   Class names are load-bearing (generated by app.js) — keep them. */

:root {
  /* gunmetal base — cool, slightly blue, not a flat near-black */
  --bg:        #0c1016;
  --bg2:       #090d12;
  --surface:   #131a24;
  --surface-2: #1a2331;
  --line:      #222d3d;
  --line-2:    #2f3d52;

  --ink:       #e7edf6;
  --muted:     #8b99ae;
  --faint:     #5c6a80;

  /* the ONE interactive accent — desaturated steel/cyan, deliberately quiet
     so it never fights the severity ramp for attention */
  --accent:    #57c3cc;
  --accent-dim:#2a5c60;
  --focus:     #57c3cc;

  /* severity ramp — the only fully-saturated colours in the app */
  --crit:  #ff4d5e;
  --high:  #ff8a3d;
  --med:   #f3c04b;
  --low:   #56b0ff;
  --info:  #7c8aa0;
  --green: #45d17f;
  --yellow:#f3c04b;
  --red:   #ff4d5e;
  --purple:#b98cff;

  --mono: "JetBrains Mono", "Cascadia Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --sans: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;

  --r:  9px;   /* panel radius */
  --r2: 6px;   /* control radius */
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  background:
    radial-gradient(1200px 600px at 78% -10%, #101a24 0%, transparent 60%),
    var(--bg);
  color: var(--ink);
  font: 14px/1.55 var(--sans);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
::selection { background: #1f4f55; color: #eafcff; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; text-underline-offset: 2px; }

/* Numbers are machine truth: tabular everywhere they appear. */
.kpi, .mono, code, kbd, th, .badge, .chip, td.mono, .num { font-variant-numeric: tabular-nums; }

/* ── header ─────────────────────────────────────────────── */
#topbar {
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  padding: 12px 20px;
  background: linear-gradient(180deg, #0e151d, #0a0e14);
  border-bottom: 1px solid var(--line);
  position: sticky; top: 0; z-index: 20;
}
.brand { display: flex; align-items: center; gap: 13px; }
.logo {
  color: var(--accent); font-size: 20px; line-height: 1;
  width: 34px; height: 34px; display: grid; place-items: center;
  border: 1px solid var(--accent-dim); border-radius: 8px;
  background: #0c1a1c; box-shadow: inset 0 0 12px rgba(87,195,204,.14);
}
h1 { font-size: 15px; margin: 0; font-weight: 650; letter-spacing: .2px; }
.sub { color: var(--muted); font-size: 11px; font-family: var(--mono); margin-top: 1px; }
.badges { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.badge {
  font: 600 11px/1.4 var(--mono);
  padding: 4px 10px; border-radius: 6px;
  border: 1px solid var(--line-2);
  background: var(--surface);
  color: var(--muted);
  white-space: nowrap;
}
.badge-ok   { border-color: #1f5c40; color: var(--green);  background: #0e2119; }
.badge-warn { border-color: #6f5514; color: var(--yellow); background: #211b0c; }
.badge-bad  { border-color: #7e2732; color: var(--crit);   background: #240f13; }

/* buttons */
.btn {
  background: var(--surface-2); color: var(--ink);
  border: 1px solid var(--line-2); border-radius: var(--r2);
  padding: 6px 13px; font: 500 13px var(--sans); cursor: pointer;
  transition: border-color .12s, background .12s, color .12s;
}
.btn:hover { border-color: var(--accent); color: #eafcff; }
.btn:disabled { opacity: .42; cursor: not-allowed; }
.btn:disabled:hover { border-color: var(--line-2); color: var(--ink); }
.btn-primary { background: #10343a; border-color: #1e6068; color: #cdf6fb; }
.btn-primary:hover { background: #164249; border-color: var(--accent); }
.btn-danger  { background: #2c1016; border-color: #7e2732; color: #ffd7db; }
.btn-danger:hover { border-color: var(--crit); }
.btn-sm { padding: 3px 9px; font-size: 12px; }
.btn-ghost { background: transparent; }

/* ── tabs ──────────────────────────────────────────────── */
#tabs {
  display: flex; gap: 2px; padding: 0 16px;
  background: #0a0e14;
  border-bottom: 1px solid var(--line);
  position: sticky; top: 59px; z-index: 19;
}
.tab {
  background: transparent; border: 0;
  color: var(--muted); padding: 11px 15px 10px; font: 500 13px var(--sans);
  cursor: pointer; position: relative; letter-spacing: .1px;
}
.tab:hover { color: var(--ink); }
.tab.active { color: #eafcff; font-weight: 600; }
.tab.active::after {
  content: ""; position: absolute; left: 10px; right: 10px; bottom: -1px;
  height: 2px; background: var(--accent); border-radius: 2px 2px 0 0;
  box-shadow: 0 0 10px rgba(87,195,204,.5);
}
.tabpane { display: none; padding: 20px; max-width: 1500px; margin: 0 auto; }
.tabpane.active { display: block; }

/* ── panels ────────────────────────────────────────────── */
.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r);
  padding: 15px 17px;
  position: relative;
}
/* section label: sentence-case with a leading keel marker — replaces the
   generic tracked ALL-CAPS eyebrow. */
.card h2, .card h3 {
  margin: 0 0 12px; font-size: 12.5px; font-weight: 600;
  color: var(--muted); letter-spacing: .1px;
  display: flex; align-items: center; gap: 8px;
}
.card h3 { font-size: 12px; margin-bottom: 9px; }
.card h2::before, .card h3::before {
  content: ""; width: 3px; height: 13px; border-radius: 2px;
  background: var(--line-2); flex: 0 0 auto;
}
/* a card can be promoted with a coloured keel to signal it carries the
   primary signal on the pane (added by app.js where it matters) */
.card.keel-crit h2::before   { background: var(--crit); box-shadow: 0 0 8px rgba(255,77,94,.55); }
.card.keel-accent h2::before { background: var(--accent); box-shadow: 0 0 8px rgba(87,195,204,.5); }
.card.keel-green h2::before  { background: var(--green); }

.muted { color: var(--muted); }
.faint { color: var(--faint); }
.mono { font-family: var(--mono); }
.row { display: flex; gap: 12px; flex-wrap: wrap; }
.grid { display: grid; gap: 13px; }
.grid.cols-2 { grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
.grid.cols-3 { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
.stack { display: flex; flex-direction: column; gap: 13px; }

/* ── severity chips — the spine ────────────────────────── */
.chip {
  display: inline-flex; align-items: center; gap: 5px;
  font: 600 11px/1.4 var(--mono);
  padding: 2px 9px; border-radius: 5px;
  border: 1px solid var(--line-2); background: var(--surface-2); color: var(--muted);
  white-space: nowrap;
}
.chip.crit { color: #ffd0d5; background: #2c1015; border-color: #8e2b37; }
.chip.high { color: #ffdcc4; background: #2c1a0d; border-color: #955417; }
.chip.med  { color: #ffedbf; background: #2a220b; border-color: #86691b; }
.chip.low  { color: #cfe6ff; background: #10243d; border-color: #23558b; }
.chip.info { color: #cbd5e2; background: #171e28; border-color: #35414f; }
/* a leading severity dot inside chips that carry it */
.chip.crit::before, .chip.high::before, .chip.med::before,
.chip.low::before, .chip.info::before {
  content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor;
  box-shadow: 0 0 6px currentColor; opacity: .9;
}

/* stacked severity meter */
.sevbar {
  display: flex; height: 8px; border-radius: 5px; overflow: hidden;
  margin: 11px 0 10px; background: #0a0e14;
  border: 1px solid var(--line); gap: 1px;
}
.sevbar div { height: 100%; }
/* scope the solid fills to the meter — .s-* also tags finding rows, which must
   NOT get a solid fill (they use the left rail instead) */
.sevbar .s-crit { background: var(--crit); } .sevbar .s-high { background: var(--high); }
.sevbar .s-med  { background: var(--med);  } .sevbar .s-low  { background: var(--low);  }
.sevbar .s-info { background: var(--info); }

/* ── tables ────────────────────────────────────────────── */
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td { text-align: left; padding: 9px 11px; border-bottom: 1px solid var(--line); vertical-align: top; }
thead th {
  position: sticky; top: 0; background: #0f1620; z-index: 1;
  color: var(--faint); font: 600 10.5px/1.3 var(--mono);
  text-transform: uppercase; letter-spacing: .7px;
  border-bottom: 1px solid var(--line-2);
}
tbody tr:last-child td { border-bottom: 0; }
tr:hover td { background: #0f1722; }
.clickable { cursor: pointer; }
.num { text-align: right; }
kbd { font: 11px var(--mono); background: var(--surface-2); border: 1px solid var(--line-2); border-bottom-width: 2px; border-radius: 4px; padding: 0 5px; }

/* endpoints: break cleanly at path separators, never mid-token */
.endpoint { max-width: 260px; font: 12px var(--mono); color: #a7c4dd; word-break: normal; overflow-wrap: break-word; }

/* ── findings ledger: left severity rail + proof-level signal ── */
tr.sev-row td:first-child { border-left: 3px solid var(--line-2); }
tr.sev-row.s-crit td:first-child { border-left-color: var(--crit); }
tr.sev-row.s-high td:first-child { border-left-color: var(--high); }
tr.sev-row.s-med  td:first-child { border-left-color: var(--med); }
tr.sev-row.s-low  td:first-child { border-left-color: var(--low); }
tr.sev-row.s-info td:first-child { border-left-color: var(--info); }
tr.sev-row.s-crit:hover td { background: #170e12; }

/* CVSS as a weighted, colour-graded number */
.cvss { font: 700 14px var(--mono); font-variant-numeric: tabular-nums; }
.cvss.g-crit { color: var(--crit); } .cvss.g-high { color: var(--high); }
.cvss.g-med  { color: var(--med); }  .cvss.g-low  { color: var(--low); }
.cvss.g-none { color: var(--faint); font-weight: 500; }

/* proof level encoded as SHAPE, not just colour */
.verify { display: inline-flex; align-items: center; gap: 6px; font: 600 11.5px var(--mono); color: var(--muted); }
.verify::before {
  content: ""; width: 9px; height: 9px; border-radius: 50%;
  border: 1.5px solid currentColor; box-sizing: border-box;
}
.verify.v-proven { color: var(--green); }                       /* verified/exploited */
.verify.v-proven::before { background: currentColor; box-shadow: 0 0 7px currentColor; }
.verify.v-confirmed { color: var(--accent); }                   /* confirmed */
.verify.v-confirmed::before { background: transparent; }        /* ring */
.verify.v-weak { color: var(--faint); }                         /* suspected/triggered */
.verify.v-weak::before { border-style: dashed; }

/* confidence label */
.conf { font: 600 12px var(--mono); }
.conf.high { color: var(--green); } .conf.medium { color: var(--med); } .conf.low { color: var(--faint); }

/* ── KPIs ──────────────────────────────────────────────── */
.kpi { font: 700 30px/1.05 var(--mono); letter-spacing: -.5px; color: var(--ink); }
.kpi-label { font-size: 11px; color: var(--muted); margin-top: 3px; letter-spacing: .2px; }
.card.keel-crit .kpi { color: #ffe3e6; }

/* phases / progress */
.phase { display: inline-flex; align-items: center; gap: 6px; margin: 3px 10px 3px 0; font-size: 12.5px; color: var(--muted); }
.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line-2); display: inline-block; flex: 0 0 auto; }
.dot.done { background: var(--green); }
.dot.running { background: var(--accent); box-shadow: 0 0 8px var(--accent); animation: pulse 1.1s infinite; }
.dot.failed { background: var(--crit); }
.dot.pending { background: #33414f; }
@keyframes pulse { 50% { opacity: .3; } }
.progress-track { background: #0a0e14; border: 1px solid var(--line); border-radius: 5px; height: 8px; overflow: hidden; }
.progress-fill { background: linear-gradient(90deg, var(--accent), var(--green)); height: 100%; }

.gate-pill {
  display: inline-flex; align-items: center; gap: 7px; margin: 3px 8px 3px 0;
  border: 1px solid var(--line-2); border-radius: 7px; padding: 5px 11px;
  font: 12px var(--mono); background: var(--surface-2);
}
.gate-pass { color: var(--green); border-color: #1f5c40; }
.gate-fail { color: var(--crit);  border-color: #7e2732; }
.gate-pending { color: var(--yellow); border-color: #6f5514; }

.list-plain { list-style: none; margin: 0; padding: 0; }
.list-plain li { padding: 7px 0; border-bottom: 1px solid var(--line); font-size: 13px; display: flex; align-items: baseline; gap: 8px; }
.list-plain li:last-child { border-bottom: 0; }
.goal { color: var(--ink); font-size: 13px; line-height: 1.55; margin: 4px 0 12px; max-width: 66ch; }

/* ── forms ─────────────────────────────────────────────── */
label { display: block; font: 500 11px/1.3 var(--sans); color: var(--muted); margin: 12px 0 5px; letter-spacing: .1px; }
input[type="text"], input[type="number"], input[type="search"], select, textarea {
  width: 100%; background: var(--bg2); color: var(--ink);
  border: 1px solid var(--line-2); border-radius: var(--r2);
  padding: 7px 10px; font: 13px var(--mono);
}
textarea { min-height: 92px; resize: vertical; line-height: 1.55; }
input:focus, textarea:focus, select:focus { outline: none; border-color: var(--focus); box-shadow: 0 0 0 3px rgba(87,195,204,.15); }
.filters { display: flex; gap: 10px; align-items: end; flex-wrap: wrap; margin-bottom: 14px; }
.filters .f { flex: 0 1 180px; }
.filters .f.wide { flex: 1 1 280px; }
.hint { font: 11.5px/1.5 var(--mono); color: var(--muted); margin-top: 4px; }
.hint.err { color: var(--crit); }
.hint.ok  { color: var(--green); }

/* ── findings detail drawer ────────────────────────────── */
.detail-row td { background: #0a1018; padding: 0; border-bottom: 1px solid var(--line-2); }
.detail { padding: 15px 18px 17px; font-size: 13px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 4px 26px; }
.detail h4 { margin: 9px 0 3px; font: 600 10.5px var(--mono); text-transform: uppercase; letter-spacing: .6px; color: var(--accent); }
.detail p { margin: 0 0 6px; white-space: pre-wrap; line-height: 1.55; color: var(--ink); }
.detail code { font-family: var(--mono); font-size: 12px; color: #a9d6ff; }

/* ── toast ─────────────────────────────────────────────── */
#toast-wrap { position: fixed; right: 18px; bottom: 18px; display: flex; flex-direction: column; gap: 9px; z-index: 60; }
.toast {
  background: var(--surface-2); border: 1px solid var(--line-2); border-left: 3px solid var(--accent);
  padding: 9px 15px; border-radius: 8px; font-size: 13px; max-width: 390px; color: var(--ink);
  box-shadow: 0 10px 30px rgba(0,0,0,.55);
  animation: slidein .18s ease-out;
}
.toast.err { border-left-color: var(--crit); }
.toast.ok  { border-left-color: var(--green); }
@keyframes slidein { from { transform: translateX(12px); opacity: 0; } }

/* ── modal ─────────────────────────────────────────────── */
.modal { position: fixed; inset: 0; background: rgba(4,7,11,.74); backdrop-filter: blur(2px);
  display: flex; align-items: center; justify-content: center; z-index: 50; }
.modal.hidden { display: none; }
.modal-box {
  width: min(880px, 94vw); max-height: 86vh; display: flex; flex-direction: column;
  background: var(--surface); border: 1px solid var(--line-2); border-radius: 12px; overflow: hidden;
  box-shadow: 0 24px 70px rgba(0,0,0,.6);
}
.modal-head { display: flex; align-items: center; gap: 10px; padding: 12px 16px;
  border-bottom: 1px solid var(--line); background: var(--surface-2); }
.modal-head strong { flex: 1; font: 600 13px var(--mono); }
#job-modal-body { display: flex; flex-direction: column; min-height: 200px; }
#job-log {
  margin: 0; padding: 14px 16px; overflow: auto; flex: 1; max-height: 56vh;
  font: 12px/1.6 var(--mono); color: #c7ecca; background: #05080d;
  white-space: pre-wrap; word-break: break-word;
}
#job-modal-done { padding: 11px 16px; border-top: 1px solid var(--line); display: none; }

/* ── Freebuff terminal tab ─────────────────────────────── */
#term-toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 11px; }
#term-toolbar .status { display: inline-flex; align-items: center; gap: 7px; font: 12px var(--mono); color: var(--muted); }
.status-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--line-2); }
.status-dot.on  { background: var(--green); box-shadow: 0 0 7px var(--green); animation: pulse 1.4s infinite; }
.status-dot.off { background: var(--crit); }
#term-cmd { flex: 1 1 300px; font-size: 12px; }
#term-stage {
  background: #05080d; border: 1px solid var(--line-2); border-radius: 10px;
  padding: 10px 12px; height: calc(100vh - 300px); min-height: 260px;
  display: flex; flex-direction: column; cursor: text;
}
#term-stage:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent) inset; }
#term-stage:focus #term-out::after { content: '█'; color: var(--green); animation: blink 1.1s steps(1) infinite; margin-left: 1px; }
@keyframes blink { 50% { opacity: 0; } }
#term-out { flex: 1; overflow: auto; margin: 0; font: 12px/1.45 var(--mono); color: #d3e7d5; white-space: pre; letter-spacing: 0; }
#term-keys { display: flex; gap: 5px; flex-wrap: wrap; margin-top: 9px; }
#term-keys .btn { padding: 3px 10px; font: 11px var(--mono); }
.term-banner {
  font: 12.5px/1.55 var(--sans); color: var(--muted); background: var(--surface-2);
  border: 1px solid var(--line); border-radius: 8px; padding: 11px 13px; margin-bottom: 11px;
}
.term-banner code { color: #a9d6ff; font-family: var(--mono); }

/* ── accessibility floor ───────────────────────────────── */
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
}

@media (max-width: 760px) {
  #topbar { flex-direction: column; align-items: stretch; }
  #tabs { top: 112px; overflow-x: auto; }
  .tabpane { padding: 14px; }
  .filters .f { flex: 1 1 100%; }
}
