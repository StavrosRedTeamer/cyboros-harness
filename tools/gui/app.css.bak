/* Stavros Console — dark console theme, zero external assets */
:root {
  --bg: #0b0e14;
  --bg2: #11151f;
  --panel: #151b28;
  --panel2: #1b2333;
  --line: #242e42;
  --txt: #d7e0ee;
  --muted: #8494ad;
  --accent: #4cc2ff;
  --green: #3ddc84;
  --yellow: #ffcb4d;
  --orange: #ff9d4d;
  --red: #ff5d6c;
  --purple: #b98cff;
  --mono: ui-monospace, SFMono-Regular, "Cascadia Mono", Menlo, Consolas, monospace;
  --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  background: var(--bg);
  color: var(--txt);
  font: 14px/1.5 var(--sans);
}
::selection { background: #26496b; }

/* ── header ─────────────────────────────────────────────── */
#topbar {
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  padding: 10px 18px;
  background: linear-gradient(180deg, #10141f, #0c0f17);
  border-bottom: 1px solid var(--line);
  position: sticky; top: 0; z-index: 20;
}
.brand { display: flex; align-items: center; gap: 12px; }
.logo { color: var(--accent); font-size: 22px; line-height: 1; }
h1 { font-size: 16px; margin: 0; letter-spacing: .4px; }
.sub { color: var(--muted); font-size: 11px; font-family: var(--mono); }
.badges { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.badge {
  font: 11px var(--mono);
  padding: 3px 9px; border-radius: 20px;
  border: 1px solid var(--line);
  background: var(--panel);
  color: var(--muted);
  white-space: nowrap;
}
.badge-ok { border-color: #1e5c3d; color: var(--green); background: #10251a; }
.badge-warn { border-color: #6b5312; color: var(--yellow); background: #251f0e; }
.badge-bad { border-color: #7c2530; color: var(--red); background: #2a1216; }
.btn {
  background: var(--panel2); color: var(--txt);
  border: 1px solid var(--line); border-radius: 6px;
  padding: 5px 12px; font-size: 13px; cursor: pointer;
}
.btn:hover { border-color: var(--accent); }
.btn:disabled { opacity: .45; cursor: not-allowed; }
.btn-primary { background: #123a55; border-color: #1d5c86; color: #cfe9ff; }
.btn-danger { background: #3a1218; border-color: #7c2530; color: #ffd7db; }
.btn-sm { padding: 2px 8px; font-size: 12px; }
.btn-ghost { background: transparent; }

/* ── tabs ──────────────────────────────────────────────── */
#tabs {
  display: flex; gap: 4px; padding: 8px 14px 0;
  background: #0d1119;
  border-bottom: 1px solid var(--line);
  position: sticky; top: 57px; z-index: 19;
}
.tab {
  background: transparent; border: 1px solid transparent; border-bottom: none;
  color: var(--muted); padding: 7px 14px; font-size: 13px;
  border-radius: 7px 7px 0 0; cursor: pointer;
}
.tab:hover { color: var(--txt); background: var(--panel); }
.tab.active {
  color: var(--accent); background: var(--bg);
  border-color: var(--line);
  font-weight: 600;
}
.tabpane { display: none; padding: 18px; }
.tabpane.active { display: block; }

/* ── generic ui ────────────────────────────────────────── */
.card {
  background: var(--panel); border: 1px solid var(--line);
  border-radius: 10px; padding: 14px 16px;
}
.card h2, .card h3 { margin: 0 0 10px; font-size: 13px; text-transform: uppercase; letter-spacing: .8px; color: var(--muted); }
.card h3 { font-size: 12px; margin-bottom: 8px; }
.muted { color: var(--muted); }
.mono { font-family: var(--mono); }
.row { display: flex; gap: 12px; flex-wrap: wrap; }
.grid { display: grid; gap: 12px; }
.grid.cols-2 { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
.grid.cols-3 { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
.stack { display: flex; flex-direction: column; gap: 12px; }
.chip {
  display: inline-block; font: 11px var(--mono);
  padding: 1px 8px; border-radius: 20px;
  border: 1px solid var(--line); background: var(--panel2); color: var(--muted);
  white-space: nowrap;
}
.chip.crit { color: #ffd7db; background: #33141a; border-color: #8e2b37; }
.chip.high { color: #ffe1c9; background: #3a2010; border-color: #96571d; }
.chip.med { color: #fff0cc; background: #33280d; border-color: #8a6d1f; }
.chip.low { color: #d9e9ff; background: #14263f; border-color: #234b7d; }
.chip.info { color: #cfd8e4; background: #1a2029; border-color: #3a4657; }
.sevbar { display: flex; height: 10px; border-radius: 5px; overflow: hidden; margin: 8px 0; }
.sevbar div { height: 100%; }
.s-crit { background: #ff5d6c; } .s-high { background: #ff9d4d; }
.s-med { background: #ffcb4d; } .s-low { background: #4cc2ff; } .s-info { background: #64748b; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #1d2433; vertical-align: top; }
th { color: var(--muted); font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: .5px; }
tr:hover td { background: #10151f; }
.clickable { cursor: pointer; }
kbd { font: 11px var(--mono); background: var(--panel2); border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 4px; padding: 0 5px; }

/* progress / phases */
.phase { display: inline-flex; align-items: center; gap: 6px; margin: 3px 6px 3px 0; }
.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line); display: inline-block; }
.dot.done { background: var(--green); }
.dot.running { background: var(--accent); animation: pulse 1s infinite; }
.dot.failed { background: var(--red); }
.dot.pending { background: #3a4657; }
@keyframes pulse { 50% { opacity: .35; } }
.progress-track { background: var(--panel2); border-radius: 5px; height: 8px; overflow: hidden; }
.progress-fill { background: linear-gradient(90deg, var(--accent), var(--green)); height: 100%; }

/* forms */
label { display: block; font-size: 11px; text-transform: uppercase; letter-spacing: .6px; color: var(--muted); margin: 10px 0 4px; }
input[type="text"], input[type="number"], input[type="search"], select, textarea {
  width: 100%; background: var(--bg2); color: var(--txt);
  border: 1px solid var(--line); border-radius: 6px;
  padding: 6px 9px; font: 13px var(--mono);
}
textarea { min-height: 90px; resize: vertical; }
input:focus, textarea:focus, select:focus { outline: none; border-color: var(--accent); }
.filters { display: flex; gap: 10px; align-items: end; flex-wrap: wrap; margin-bottom: 12px; }
.filters .f { flex: 0 1 180px; }
.filters .f.wide { flex: 1 1 260px; }
.hint { font-size: 11px; color: var(--muted); font-family: var(--mono); margin-top: 3px; }
.hint.err { color: var(--red); }
.hint.ok { color: var(--green); }

/* findings detail drawer */
.detail-row td { background: #0d1320; padding: 0; }
.detail { padding: 12px 16px; font-size: 13px; }
.detail h4 { margin: 8px 0 4px; font-size: 11px; text-transform: uppercase; letter-spacing: .6px; color: var(--muted); }
.detail p { margin: 0 0 8px; white-space: pre-wrap; }
.detail code { font-family: var(--mono); font-size: 12px; color: #a9d6ff; }

/* toast */
#toast-wrap { position: fixed; right: 16px; bottom: 16px; display: flex; flex-direction: column; gap: 8px; z-index: 60; }
.toast {
  background: var(--panel2); border: 1px solid var(--line); border-left: 3px solid var(--accent);
  padding: 8px 14px; border-radius: 8px; font-size: 13px; max-width: 380px;
  box-shadow: 0 6px 24px rgba(0,0,0,.5);
  animation: slidein .18s ease-out;
}
.toast.err { border-left-color: var(--red); }
.toast.ok { border-left-color: var(--green); }
@keyframes slidein { from { transform: translateX(12px); opacity: 0; } }

/* modal */
.modal {
  position: fixed; inset: 0; background: rgba(4,6,10,.7);
  display: flex; align-items: center; justify-content: center; z-index: 50;
}
.modal.hidden { display: none; }
.modal-box {
  width: min(860px, 94vw); max-height: 86vh; display: flex; flex-direction: column;
  background: var(--bg2); border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
}
.modal-head {
  display: flex; align-items: center; gap: 10px; padding: 10px 14px;
  border-bottom: 1px solid var(--line); background: var(--panel);
}
.modal-head strong { flex: 1; font-size: 13px; font-family: var(--mono); }
#job-modal-body { display: flex; flex-direction: column; min-height: 200px; }
#job-log {
  margin: 0; padding: 12px 14px; overflow: auto; flex: 1; max-height: 56vh;
  font: 12px/1.6 var(--mono); color: #bfe0c0; background: #070a10;
  white-space: pre-wrap; word-break: break-word;
}
#job-modal-done { padding: 10px 14px; border-top: 1px solid var(--line); display: none; }

/* overview specifics */
.kpi { font-size: 22px; font-weight: 700; font-family: var(--mono); }
.kpi-label { font-size: 11px; text-transform: uppercase; letter-spacing: .6px; color: var(--muted); }
.gate-pill {
  display: inline-flex; align-items: center; gap: 7px; margin: 3px 8px 3px 0;
  border: 1px solid var(--line); border-radius: 8px; padding: 4px 10px;
  font: 12px var(--mono);
}
.gate-pass { color: var(--green); border-color: #1e5c3d; }
.gate-fail { color: var(--red); border-color: #7c2530; }
.gate-pending { color: var(--yellow); border-color: #6b5312; }
.list-plain { list-style: none; margin: 0; padding: 0; }
.list-plain li { padding: 3px 0; border-bottom: 1px dashed #1d2433; font-size: 13px; }
.goal { color: var(--muted); font-size: 12.5px; font-style: italic; margin: 2px 0 10px; }

/* ── Freebuff terminal tab ────────────────────────────── */
#term-toolbar {
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  margin-bottom: 10px;
}
#term-toolbar .status {
  display: inline-flex; align-items: center; gap: 7px;
  font: 12px var(--mono); color: var(--muted);
}
.status-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--line); }
.status-dot.on { background: var(--green); box-shadow: 0 0 6px var(--green); animation: pulse 1.4s infinite; }
.status-dot.off { background: var(--red); }
#term-cmd { flex: 1 1 300px; font-size: 12px; }
#term-stage {
  background: #04070b; border: 1px solid #1c2938; border-radius: 10px;
  padding: 8px 10px; height: calc(100vh - 300px); min-height: 260px;
  display: flex; flex-direction: column;
  cursor: text;
}
#term-stage:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent) inset; }
#term-stage:focus #term-out::after { content: '█'; color: var(--green); animation: blink 1.1s steps(1) infinite; margin-left: 1px; }
@keyframes blink { 50% { opacity: 0; } }
#term-out {
  flex: 1; overflow: auto; margin: 0;
  font: 12px/1.45 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  color: #d8e6d8; white-space: pre; letter-spacing: 0;
}
#term-keys { display: flex; gap: 5px; flex-wrap: wrap; margin-top: 8px; }
#term-keys .btn { padding: 2px 9px; font: 11px var(--mono); }
.term-banner {
  font-size: 12.5px; color: var(--muted); background: var(--panel2);
  border: 1px dashed var(--line); border-radius: 8px; padding: 10px 12px; margin-bottom: 10px;
}
.term-banner code { color: #a9d6ff; }

@media (max-width: 760px) {
  #topbar { flex-direction: column; align-items: stretch; }
  #tabs { top: 96px; overflow-x: auto; }
  .filters .f { flex: 1 1 100%; }
}
