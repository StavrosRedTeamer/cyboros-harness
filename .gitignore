# Segreti e config di engagement — creati a partire da *.example.json / template
auth.json
c2.json
scope.json
# Scope del benchmark (loopback-only, seed del bench): e' un'autorizzazione come scope.json,
# anche se innocua. Nessun file di autorizzazione nel repo.
scope.bench.json
wifi-scope.json
scope.wof.json
mobile-scope.json
mcp.json

# Report, loot, findings e stato runtime (tutto generato)
# Evidenze/PII dei client non vanno nel repo; loot.jsonl e sessions.json
# contengono segreti in chiaro e NON devono mai essere committati.
reports/
!reports/.gitkeep

# Dati di engagement: inventario, indici evidenza, matrici, stato sessione
artifacts/
assets.md
coverage-matrix.md
evidence-index.md
gate-log.md
operation-state.json
residue.md
evidence/
engagements/
recon/
# Script one-off di engagement: contengono target/host/session-key reali. Il posto giusto è
# local-only/ (ignorata per intero, nessuna regola da ricordare): le regole per-nome qui sotto
# restano per i file storici già presenti.
local-only/
# Nota: il trattino in "probe-*" non copriva "probe_ajax.py" — da qui il secondo pattern.
scripts/probe-*.py
scripts/probe_*.py
scripts/debug_session.py
scripts/record-*-findings.js
# Dump di sessione/engagement grezzi (tracciato di un device reale, id installazione,
# chiavi di sessione). I tool generici stanno in tools/.
freebuff-blocchi-*.txt

# Tool vendored (binari grandi, obscura/frida) e mirror: mai nel repo
vendor/

# Runtime
# Self-referential symlink accidentalmente creato dentro il progetto (recursione scan)
Scrivania
# temp/ = dump di lavoro per-engagement (apk decompilati, HTML di target, cache,
# evidenze, IP/host reali). Non è "temporaneo": contiene dati cliente. Mai nel repo.
temp/
# Backup di scope con target reali (scope.*.bak.json): solo *.example.json è versionato.
scope.*.bak.json
# ...e la variante con la data nel suffisso (scope.json.bak-YYYYMMDD[-label]): il pattern qui
# sopra ha l'ordine invertito e non la copriva, quindi restavano untracked ma addabili.
scope.json.bak-*
tools/.pace.json
tools/.test-routes.txt
node_modules/
npm-debug.log*
__pycache__/
*.pyc

# Command Center — engagement data (client names, RoE contacts, approvals).
# These are local engagement state: never commit them.
campaign.json
campaigns/
reports/approvals.jsonl
reports/campaign-history.jsonl
reports/app/

# File di backup sparsi: mai committarne di nuovi. Gli esistenti
# (tools/gui/*.bak, *.v1-forensic) sono storico della GUI redesign e restano
# finché non li rimuovi esplicitamente.
*.bak
*.v1-forensic
*.orig
*.rej

# Editor: i file di swap contengono il contenuto del file aperto — se è `scope.json`, sono
# dati di engagement (target, commenti, credenziali) fuori dal .gitignore solo per distrazione.
*.kate-swp
*.swp
*.swo
.*.swp

# OS
.DS_Store
Thumbs.db

# refs/ — knowledge corpus, non sorgente del progetto. contiene ampie sezioni riprese
# testualmente da documenti di terzi (fonti e licenze per gruppo non registrate), quindi
# non e' ridistribuibile finche' quei crediti non sono recuperati. Fuori dal repository
# pubblico: l'harness non lo legge mai in codice (niente in npm test, doctor --check o
# tools/ lo richiede) e i file restano su disco. Per riportarlo: git add -f refs/
# — vedi docs/LAUNCH-PLAN.md, blocker 1.
refs/

# Runbook interno di una postazione specifica, non un documento del progetto.
session-prompt-egress-f3.md
