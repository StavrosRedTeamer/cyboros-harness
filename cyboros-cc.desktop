#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=Cyboros Command Center
GenericName=Red team console
Comment=Desktop console for Cyboros Harness
Exec=cyboros-cc %U
Icon=cyboros-cc
Terminal=false
Categories=Development;Security;
StartupNotify=true
StartupWMClass=cyboros-cc
Actions=ReadOnly;Web;

[Desktop Action ReadOnly]
Name=Open read-only
Exec=cyboros-cc --read-only

[Desktop Action Web]
Name=Open in browser
Exec=cyboros-cc --web
