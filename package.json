{
  "name": "stavrosredteamer",
  "version": "0.0.0",
  "private": true,
  "description": "A penetration-testing harness where a finding is only a finding if code can prove it: policy enforced in the runtime, severity capped by evidence. Zero dependencies, offline-capable.",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "security",
    "pentest",
    "penetration-testing",
    "red-team",
    "ai-agent",
    "guardrails",
    "benchmark"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CSI-entitymorton/stavrosredteamer.git"
  },
  "bugs": {
    "url": "https://github.com/CSI-entitymorton/stavrosredteamer/issues"
  },
  "homepage": "https://github.com/CSI-entitymorton/stavrosredteamer#readme",
  "bin": {
    "stavros": "tools/stavros.js",
    "stavros-doctor": "tools/doctor.js",
    "stavros-record-finding": "tools/record-finding.js",
    "stavros-gen-bench": "tools/gen-bench.js",
    "stavros-mcp-guard-proxy": "tools/mcp-guard-proxy.js"
  },
  "files": [
    "tools/",
    "docs/",
    "local/",
    "skills/",
    "workflows/",
    "templates/",
    "ops/",
    "knowledge.md",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "BENCHMARK.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tools/run-tests.js",
    "test:ci": "node tools/run-tests.js --jobs 2",
    "test:all": "node tools/run-tests.js --e2e",
    "test:list": "node tools/run-tests.js --list",
    "console": "node tools/gui-server.js",
    "radar": "node tools/radar.js run",
    "galaxy": "node tools/attack-galaxy.js",
    "doctor": "node tools/doctor.js",
    "demo": "bash tools/demo.sh"
  }
}
