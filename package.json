{
  "name": "cyboros-harness",
  "version": "0.2.0",
  "private": true,
  "description": "A penetration-testing harness where a finding is only a finding if code can prove it: policy enforced in the runtime, severity capped by evidence, and the lesson of one engagement carried into the next. Zero dependencies, offline-capable.",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "security",
    "pentest",
    "penetration-testing",
    "red-team",
    "ai-agent",
    "guardrails",
    "benchmark"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stavrosredteamer/cyboros-harness.git"
  },
  "bugs": {
    "url": "https://github.com/stavrosredteamer/cyboros-harness/issues"
  },
  "homepage": "https://github.com/stavrosredteamer/cyboros-harness#readme",
  "bin": {
    "cyboros": "tools/cyboros.js",
    "cyboros-tui": "runtime/tui.js",
    "cyboros-doctor": "tools/doctor.js",
    "cyboros-record-finding": "tools/record-finding.js",
    "cyboros-gen-bench": "tools/gen-bench.js",
    "cyboros-mcp-guard-proxy": "tools/mcp-guard-proxy.js"
  },
  "files": [
    "tools/",
    "runtime/",
    "!runtime/providers.json",
    "demo/",
    "docs/",
    "local/",
    "skills/",
    "workflows/",
    "templates/",
    "ops/",
    "knowledge.md",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "BENCHMARK.md",
    "LICENSE"
  ],
  "scripts": {
    "pretest": "node tools/ensure-test-scope.js",
    "test": "node tools/run-tests.js",
    "pretest:ci": "node tools/ensure-test-scope.js",
    "test:ci": "node tools/run-tests.js --jobs 2",
    "pretest:all": "node tools/ensure-test-scope.js",
    "test:all": "node tools/run-tests.js --e2e",
    "test:list": "node tools/run-tests.js --list",
    "console": "node tools/gui-server.js",
    "tui": "node runtime/tui.js",
    "radar": "node tools/radar.js run",
    "galaxy": "node tools/attack-galaxy.js",
    "doctor": "node tools/doctor.js",
    "demo": "bash tools/demo.sh"
  }
}
