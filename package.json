{
  "name": "stavrosredteamer",
  "version": "0.0.0",
  "private": true,
  "description": "A penetration-testing harness where a finding is only a finding if code can prove it: policy enforced in the runtime, severity capped by evidence. Zero dependencies, offline-capable.",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "security",
    "pentest",
    "penetration-testing",
    "red-team",
    "ai-agent",
    "guardrails",
    "benchmark"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "test": "node tools/run-tests.js",
    "test:ci": "node tools/run-tests.js --jobs 2",
    "test:all": "node tools/run-tests.js --e2e",
    "test:list": "node tools/run-tests.js --list",
    "console": "node tools/gui-server.js",
    "radar": "node tools/radar.js run",
    "galaxy": "node tools/attack-galaxy.js",
    "doctor": "node tools/doctor.js"
  }
}
