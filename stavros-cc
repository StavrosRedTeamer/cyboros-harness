#!/usr/bin/env bash
# Stavros Command Center — desktop launcher (WP2).
# Prefers the PyQt6 shell; falls back to Chromium app-mode, then the default browser.
# The backend stays owned by tools/gui-server.js (single instance via cc-instance).
set -euo pipefail

WS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$WS"

if ! command -v node >/dev/null 2>&1; then
  echo "stavros-cc: node >= 22 is required" >&2
  exit 1
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
  echo
  echo "options: --read-only --web --headless --kiosk --keep-server"
  exit 0
fi

exec python3 "$WS/tools/app/scc.py" "$@"
