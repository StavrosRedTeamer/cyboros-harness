[Unit]
Description=Cyboros Radar Ecosystem Intelligence Scout
After=network.target

[Service]
Type=oneshot
# Env opzionale (~/.config/radar.env) per OMNIROUTE_API_KEY / OMNIROUTE_MODEL —
# il file non va committato; il prefisso '-' rende l'EnvironmentFile opzionale.
EnvironmentFile=-%h/.config/radar.env
WorkingDirectory=%h/Scrivania/stavrosredteamer
ExecStart=/usr/bin/node tools/radar.js run
StandardOutput=journal
StandardError=journal